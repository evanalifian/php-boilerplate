{
  "name": "php-boilerplate",
  "version": "1.0.0",
  "description": "A starter template to build website using native PHP and MVC pattern implementation.",
  "homepage": "https://github.com/evanalifian/php-boilerplate#readme",
  "bugs": {
    "url": "https://github.com/evanalifian/php-boilerplate/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evanalifian/php-boilerplate.git"
