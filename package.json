  "scripts": {
    "dev": "concurrently \"php -S localhost:8000 -t public\" \"npx @tailwindcss/cli -i ./public/css/input.css -o ./public/css/output.css --watch\""
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "tailwindcss@4.3.3": true
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}